<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Canetrack" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Match circle_blue color (#4f8ef7) -->
        <item name="colorPrimary">#4f8ef7</item>
        <item name="colorSurfaceVariant">#F5F5F5</item>

        <!-- Primary buttons (Track, Set Safe Zone) are always light blue -->
        <item name="quickActionPrimaryBackground">#4f8ef7</item>
        <!-- Other buttons are dark in light mode -->
        <item name="quickActionSecondaryBackground">#333333</item>
        <item name="quickActionContentColor">#FFFFFF</item>
    </style>

    <style name="Theme.Canetrack" parent="Base.Theme.Canetrack" />
</resources>